# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# Free API key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# CAISO = California Independent System Operator, the balancing authority
# covering Northern & Central California (and most of the state).
EIA_RESPONDENT=CISO

# Representative Northern California coordinates for weather (Sacramento).
WEATHER_LAT=38.5816
WEATHER_LON=-121.4944
WEATHER_LOCATION_NAME=Sacramento_NorCal

# Rolling lookback window for ingestion (days)
LOOKBACK_DAYS=30
