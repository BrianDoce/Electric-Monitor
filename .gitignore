# Environment / secrets
.env

# DuckDB warehouse (binary, regenerated by pipeline)
warehouse/*.duckdb
warehouse/*.duckdb.wal
!warehouse/.gitkeep

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Exported marts (regenerated artifacts, not source)
data/marts/*.parquet
data/marts/*.csv
!data/marts/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
